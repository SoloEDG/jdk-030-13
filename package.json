{
  "name": "jdk-030-stacklatch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:lending": "node --experimental-strip-types --loader ./scripts/alias-loader.mjs scripts/check-lending.ts",
    "test:solvable": "node --max-old-space-size=2048 --experimental-strip-types --loader ./scripts/alias-loader.mjs scripts/check-solvable.ts",
    "test": "npm run test:lending && npm run test:solvable"
  },
  "dependencies": {
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/compiler-sfc": "^3.5.24",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vue-tsc": "^3.1.4"
  }
}
